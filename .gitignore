# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# auto-start logs
/scripts/*.log

# chat history exports (may contain private details)
/history/
/.next-b/
/.next-build/

# Android app build output and signing key (keep release.jks backed up!)
/android/build/
/android/dist/
/android/release.jks

# Local AI models for photo search and People (downloaded once)
/.ai-models/

# Research notes and reports
/research_notes/
/reports/

# Test-only pretend backup drive
/.backup-test-root

# Android private values (signing-key password, app-lock PIN hash)
/android/secrets.properties
/android/src/com/puneetstudios/app/Secrets.java
